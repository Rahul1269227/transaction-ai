# Database Configuration
DATABASE_URL=postgresql://txn_user:txn_password@localhost:5432/transactions

# Redis Configuration
REDIS_URL=redis://localhost:6379/0

# Application Paths
TAXONOMY_PATH=data/taxonomy.yaml
GAZETTEER_PATH=data/gazetteer/merchant_aliases.csv
# Use the balanced model for best performance across all categories
MODEL_PATH=models/transaction_classifier_balanced

# API Configuration
API_HOST=0.0.0.0
API_PORT=8000
API_RELOAD=true

# Confidence Thresholds
AUTO_ACCEPT_THRESHOLD=0.85
REVIEW_THRESHOLD=0.60

# ML Configuration
ENCODER_MODEL=sentence-transformers/all-MiniLM-L6-v2
CLASSIFIER_TYPE=lightgbm

# Logging
LOG_LEVEL=INFO

# Monitoring & Observability
PROMETHEUS_ENABLED=true
METRICS_PORT=9090

# Ensemble Router Configuration
USE_ENSEMBLE=false
RULE_WEIGHT=0.3
ML_WEIGHT=0.4
LLM_WEIGHT=0.3

# LLM Service Configuration (for Ensemble Mode)
LLM_URL=http://localhost:11434
LLM_MODEL=llama3.1:8b
FEW_SHOT_EXAMPLES_PATH=data/few_shot_examples.jsonl

# Cache Configuration
CACHE_TTL=600
