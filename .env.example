# ========================================
# Transaction AI Configuration
# ========================================
# Copy this file to .env and customize values for your environment

# ========================================
# Database Configuration
# ========================================
# PostgreSQL database URL for persistence
# Format: postgresql://user:password@host:port/database
DATABASE_URL=postgresql://txn_user:txn_password@localhost:5432/txn_user

# Database credentials (used by Docker)
POSTGRES_DB=txn_user
POSTGRES_USER=txn_user
POSTGRES_PASSWORD=txn_password
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# ========================================
# Redis Cache Configuration
# ========================================
# Redis URL for caching and response storage
REDIS_URL=redis://localhost:6379/0
REDIS_HOST=localhost
REDIS_PORT=6379
CACHE_TTL=600  # Cache time-to-live in seconds (default: 10 minutes)

# ========================================
# Application Paths
# ========================================
# Taxonomy file defines categories and patterns (28 balanced categories)
TAXONOMY_PATH=data/taxonomy.yaml

# Merchant gazetteer for merchant name resolution
GAZETTEER_PATH=data/gazetteer/merchant_aliases.csv

# ML model path - LightGBM balanced model (98.42% macro F1, 98.43% accuracy)
MODEL_PATH=models/transaction_classifier

# Few-shot examples for LLM (optional, used in ensemble mode)
FEW_SHOT_EXAMPLES_PATH=data/few_shot_examples.jsonl

# ========================================
# API Server Configuration
# ========================================
# API host and port
API_HOST=0.0.0.0
API_PORT=8000

# Enable auto-reload for development (disable in production)
API_RELOAD=true

# Logging level (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL=INFO

# ========================================
# Confidence Thresholds
# ========================================
# Auto-accept threshold - transactions above this confidence are accepted automatically
AUTO_ACCEPT_THRESHOLD=0.85

# Review threshold - transactions below this confidence require manual review
REVIEW_THRESHOLD=0.60

# ========================================
# ML Model Configuration
# ========================================
# Sentence transformer model for embeddings
ENCODER_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Classifier type (lightgbm, randomforest, xgboost)
CLASSIFIER_TYPE=lightgbm

# ========================================
# Ensemble Router Configuration
# ========================================
# Enable ensemble mode (uses MCC, Rules, ML, and LLM together)
# Set to true for maximum accuracy, false for faster responses
USE_ENSEMBLE=false

# Fast mode - skip LLM when Rule+ML agree with high confidence
FAST_MODE=false
FAST_MODE_THRESHOLD=0.90

# Parallel execution for ensemble methods
ENABLE_PARALLEL=true

# ========================================
# Ensemble Weights (should sum to 1.0)
# ========================================
# MCC (Merchant Category Code) - highly accurate when available (ISO 18245)
MCC_WEIGHT=0.15

# Rules - deterministic patterns for known transaction types
RULE_WEIGHT=0.15

# ML - trained embedding classifier with semantic understanding
ML_WEIGHT=0.65

# LLM - reasoning for edge cases and ambiguous transactions
LLM_WEIGHT=0.05

# ========================================
# Rules Engine Configuration
# ========================================
# Rule-based confidence levels
RULE_HIGH_CONFIDENCE=0.95      # Confidence for deterministic rules
RULE_MEDIUM_CONFIDENCE=0.90    # Confidence for amount-based rules
RULE_MAX_CONFIDENCE=0.98       # Maximum confidence after boosts

# ========================================
# MCC Classifier Configuration
# ========================================
# MCC-based confidence levels
MCC_HIGH_CONFIDENCE=0.95       # Confidence for high-specificity MCC codes
MCC_LOW_CONFIDENCE=0.85        # Confidence for general MCC codes

# ========================================
# Ensemble Router Advanced Configuration
# ========================================
# Merchant matching thresholds
MERCHANT_CONFIDENCE_THRESHOLD=0.70   # Minimum confidence for merchant match early exit
MERCHANT_CONFIDENCE_BOOST=0.10       # Boost applied to merchant matches

# Early exit thresholds
RULE_EARLY_EXIT_THRESHOLD=0.95       # Confidence threshold for rule-based early exit
MCC_EARLY_EXIT_THRESHOLD=0.90        # Confidence threshold for MCC early exit

# Agreement scoring
FULL_AGREEMENT_BOOST=0.20            # Confidence boost when all methods agree
PARTIAL_AGREEMENT_BOOST=0.10         # Confidence boost when 2+ methods agree
NO_AGREEMENT_PENALTY=0.15            # Confidence penalty when only one method votes

# LLM fallback configuration
LLM_FALLBACK_THRESHOLD=0.60          # Skip LLM when ML confidence exceeds this

# Confidence-Based Routing (Smart ML/LLM Selection)
ML_CONFIDENCE_THRESHOLD=0.80         # Use LLM if ML confidence < this threshold
RULE_CONFIDENCE_THRESHOLD=0.80       # Use LLM if Rule confidence < this threshold
LLM_ONLY_FOR_AMBIGUOUS=true          # Only invoke LLM for ambiguous cases (saves API costs and latency)

# Thread pool configuration
MAX_WORKERS=4                        # Maximum concurrent threads for parallel execution

# ========================================
# LLM Service Configuration
# ========================================
# LLM service URL (Ollama, OpenAI, etc.)
LLM_URL=http://localhost:11434

# LLM model name
# For Ollama: llama3.1:8b, llama3:8b, mistral:7b, gemma:7b
# For OpenAI: gpt-4, gpt-3.5-turbo
LLM_MODEL=llama3.1:8b

# LLM request timeout in seconds
LLM_TIMEOUT=3.0

# LLM generation parameters
LLM_TEMPERATURE=0.05          # Lower = more deterministic (0.0-1.0)
LLM_TOP_P=0.8                 # Nucleus sampling threshold
LLM_MAX_TOKENS=80             # Maximum tokens to generate
LLM_NUM_THREADS=4             # Threads for model inference
LLM_REQUEST_TIMEOUT=120       # Full request timeout (seconds)
LLM_FEW_SHOT_LIMIT=5          # Max few-shot examples in prompt
LLM_MAX_CONCURRENT=4          # Max concurrent LLM requests
LLM_HEALTH_CHECK_TIMEOUT=5    # Health check timeout (seconds)

# Ollama host (for Docker)
OLLAMA_HOST=0.0.0.0

# ========================================
# Monitoring & Observability
# ========================================
# Enable Prometheus metrics endpoint (/metrics)
PROMETHEUS_ENABLED=false
METRICS_PORT=9090

# Grafana admin credentials (for monitoring profile)
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=admin
GRAFANA_PORT=3000

# ========================================
# Docker-specific Configuration
# ========================================
# Container ports mapping (host:container)
POSTGRES_EXTERNAL_PORT=5432
REDIS_EXTERNAL_PORT=6379
API_EXTERNAL_PORT=8000
LLM_EXTERNAL_PORT=11434
PROMETHEUS_EXTERNAL_PORT=9090
GRAFANA_EXTERNAL_PORT=3000

# Container names
POSTGRES_CONTAINER=txn-postgres
REDIS_CONTAINER=txn-redis
API_CONTAINER=txn-api
LLM_CONTAINER=txn-llm
PROMETHEUS_CONTAINER=txn-prometheus
GRAFANA_CONTAINER=txn-grafana

# Network name
NETWORK_NAME=txn-network

# ========================================
# Training Configuration
# ========================================
# Minimum feedback count before triggering retraining
MIN_FEEDBACK_COUNT=5

# Training job timeout (seconds)
TRAINING_TIMEOUT=900

# Output directories for training
TRAINING_OUTPUT_DIR=data/learning
FEEDBACK_DIR=data/feedback
CORRECTIONS_DIR=data/corrections

# ========================================
# Development Configuration
# ========================================
# Python version for development
PYTHON_VERSION=3.9

# Enable/disable features for development
DEBUG_MODE=false
ENABLE_PROFILING=false
