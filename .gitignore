# Data - Only source data is tracked, generated data is ignored
# SOURCE DATA (tracked):
#   - data/taxonomy.yaml (manually created)
#   - data/gazetteer/ (manually created)
#   - data/raw/ (Kaggle downloads - KEEP THESE!)
#
# GENERATED DATA (ignored - can be regenerated by scripts):
#   - data/datasets/ (generated by scripts/generate_dataset.py)
#   - data/balanced/ (generated by scripts/prepare_balanced_dataset.py)
#   - data/processed/ (generated during training)
#   - data/labeled/ (generated by scripts/label_real_data.py)

# Ignore all generated datasets
data/datasets/*.jsonl
data/balanced/*.jsonl
data/balanced/*.json
data/processed/*.jsonl
data/processed/*.csv
data/labeled/*.jsonl
data/labeled/*.csv
data/labeled/*.yaml

# Keep source data and Kaggle downloads
!data/taxonomy.yaml
!data/gazetteer/
!data/gazetteer/*.csv
!data/raw/
!data/raw/*.csv
!data/raw/*.xlsx
!data/raw/*.json
!data/few_shot_examples.jsonl
!data/**/.gitkeep

# Temporary data files
data/feedback/*.jsonl
data/feedback/*.json
!data/feedback/.gitkeep

